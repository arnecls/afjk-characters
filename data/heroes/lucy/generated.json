    "description": "A Celestial Spirit Mage who can summon Celestial Spirits using Gate Keys to assist in battle.",
    "skills": [
      {
        "section": "Ultimate",
        "name": "Celestial Spirit Summon",
        "unlock": "Unlocks at Level 1",
        "meta": {
          "Skill Range": "1 tile",
          "Initial Energy": "700"
        },
        "description": {
          "raw": "Lucy calls out Aquarius, a Celestial Spirit, to assist her in battle. Aquarius has 120% of Lucy's max HP and 100% of Lucy's other stats. Upon entering battle, Aquarius immediately conjures a water swirl that strikes the 1-tile area with the most enemies, dealing 300% (ATK-based) + 30% (SP-based) damage to all enemies in the area. The affected enemies are knocked into the air and stunned for 2s. The water swirl attack repeats every 10s. Aquarius' normal attack deals 100% (ATK-based) + 10% (SP-based) damage with a range of 10 tiles.",
          "active": [
            "Lucy calls out Aquarius, a Celestial Spirit, to assist her in battle.",
            "Aquarius has 120% of Lucy's max HP and 100% of Lucy's other stats.",
            "Upon entering battle, Aquarius immediately conjures a water swirl that strikes the 1-tile area with the most enemies, dealing 300% (ATK-based) + 30% (SP-based) damage to all enemies in the area.",
            "The affected enemies are knocked into the air and stunned for 2s.",
            "The water swirl attack repeats every 10s.",
            "Aquarius' normal attack deals 100% (ATK-based) + 10% (SP-based) damage with a range of 10 tiles."
          ],
          "upgrades": [
            {
              "level": "2",
              "unlock": "Unlocks at Level 51",
              "text": [
                "Increases the damage to Aquarius' water swirl to 325% (ATK-based) + 30% (SP-based)."
              ]
            },
            {
              "level": "3",
              "unlock": "Unlocks at Level 111",
              "text": [
                "Increases the damage to Aquarius' water swirl to 350% (ATK-based) + 30% (SP-based)."
              ]
            },
            {
              "level": "4",
              "unlock": "Unlocks at Level 171",
              "text": [
                "Increases the damage to Aquarius' water swirl to 375% (ATK-based) + 30% (SP-based)."
              ]
            },
            {
              "level": "5",
              "unlock": "Unlocks at Level 231",
              "text": [
                "Increases the damage to Aquarius' water swirl to 400% (ATK-based) + 30% (SP-based)."
              ]
            }
          ]
        },
        "description_lite": "Lucy calls out Aquarius, a Celestial Spirit, to assist her in battle. Aquarius inherits some of Lucy's stats. Upon entering battle, Aquarius immediately starts a water swirl attack that deals AoE damage, knocks enemies into the air, and stuns them. This water swirl attack repeats at regular intervals."
      },
      {
