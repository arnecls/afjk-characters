      {
        "section": "Ex. Skill",
        "name": "Mystic Recollection",
        "unlock": "Unlocks at Mythic+",
        "meta": {
          "Skill Range": "Global"
        },
        "description": {
          "raw": "Cyran mimics some of Merlin's impressive spells, casting them in the following sequence when a battle starts: Enlightening Spell: Grants himself 30 Haste for 8s, during which he is unaffected. Confining Spell: Deals 25% (ATK-based) damage to the rearmost enemy, imprisoning them for 1.5s and preventing from moving or acting. Starshard Spell: Conjures a dark flame across the battlefield, dealing 40% (ATK-based) true damage to all enemies and reducing their ATK SPD by 20 for 5s.",
          "active": [
            "Cyran mimics some of Merlin's impressive spells, casting them in the following sequence when a battle starts: Enlightening Spell: Grants himself 30 Haste for 8s, during which he is unaffected.",
            "Confining Spell: Deals 25% (ATK-based) damage to the rearmost enemy, imprisoning them for 1.5s and preventing from moving or acting.",
            "Starshard Spell: Conjures a dark flame across the battlefield, dealing 40% (ATK-based) true damage to all enemies and reducing their ATK SPD by 20 for 5s."
          ],
          "upgrades": [
            {
              "level": "2",
              "unlock": "Unlocks at EX. +5",
              "text": [
                "Increases dark flame damage to 45% (ATK-based)."
              ]
            },
            {
              "level": "3",
              "unlock": "Unlocks at EX. +10",
              "text": [
                "If Merlin is present on the enemy side, Merlin is silenced for 8s when a battle starts, preventing Merlin from casting any skills.",
                "Any skills Merlin would've cast when a battle starts are triggered after silence ends, at which point Cyran loses 5% of his current HP.",
                "If Merlin is absent on the enemy side, Cyran permanently increases his ATK by 10%."
              ]
            },
            {
              "level": "4",
              "unlock": "Unlocks at EX. +15",
              "text": [
                "Increases dark flame damage to 50% (ATK-based)."
              ]
            }
          ]
        },
        "description_lite": "Cyran draws on spells from his memories, casting them when a battle starts to enhance himself an attack enemies."
