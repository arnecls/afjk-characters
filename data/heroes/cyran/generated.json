              "level": "2",
              "unlock": "Unlocks at Level 51",
              "text": [
                "Increases the black hole's damage to enemies within the center to 17% (ATK-based) + 2% (SP-based) per 0.25s, and to enemies at the edges to 7% (ATK-based) + 1% (SP-based) per second."
              ]
            },
            {
              "level": "3",
              "unlock": "Unlocks at Level 111",
              "text": [
                "Increases the black hole's damage to enemies within the center to 18% (ATK-based) + 2% (SP-based) per 0.25s, and to enemies at the edges to 8% (ATK-based) + 1% (SP-based) per second."
              ]
            },
            {
              "level": "4",
              "unlock": "Unlocks at Level 171",
              "text": [
                "Increases the black hole's damage to enemies within the center to 19% (ATK-based) + 2% (SP-based) per 0.25s, and to enemies at the edges to 9% (ATK-based) + 1% (SP-based) per second."
              ]
            },
            {
              "level": "5",
              "unlock": "Unlocks at Level 231",
              "text": [
                "Increases the black hole's damage to enemies within the center to 20% (ATK-based) + 2% (SP-based) per 0.25s, and to enemies at the edges to 10% (ATK-based) + 1% (SP-based) per second."
              ]
            }
          ]
        },
        "description_lite": "Cyran summons a black hole that continuously pulls enemies toward its center while dealing damage. Enemies with low HP within the center are immediately defeated."
