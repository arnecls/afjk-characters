            {
              "level": "5",
              "unlock": "Unlocks at Level 231",
              "text": [
                "Increases damage per second to 110% (ATK-based) + 12% (SP-based)."
              ]
            }
          ]
        },
        "description_lite": "Tasi summons a dream to hypnotize all enemies, causing them to take damage each second."
      },
      {
        "section": "Skill1",
        "name": "Dream Dance",
        "unlock": "Unlocks at Level 11",
        "meta": {
          "Cooldown": "6s",
          "Initial Cooldown": "3s",
          "Skill Range": "10 tiles"
        },
        "description": {
          "raw": "Tasi consumes 10% of her current HP to deal damage equal to 110% + 10% (SP-based) of her consumed HP to adjacent enemies, stunning them for 0.5s. The damage dealt will be no less than 60% (ATK-based). She then flies to the farthest enemy and applies the same effect to adjacent enemies. However, the second hit on the same enemy will deal only 50% of the original damage.",
          "active": [
            "Tasi consumes 10% of her current HP to deal damage equal to 110% + 10% (SP-based) of her consumed HP to adjacent enemies, stunning them for 0.5s.",
            "The damage dealt will be no less than 60% (ATK-based).",
            "She then flies to the farthest enemy and applies the same effect to adjacent enemies.",
            "However, the second hit on the same enemy will deal only 50% of the original damage."
          ],
          "upgrades": [
            {
              "level": "2",
              "unlock": "Unlocks at Level 71",
              "text": [
                "Increases damage to 120% + 10% (SP-based) of her consumed HP."
              ]
            },
            {
              "level": "3",
              "unlock": "Unlocks at Level 131",
              "text": [
                "Increases damage to 130% + 10% (SP-based) of her consumed HP."
              ]
            },
            {
              "level": "4",
              "unlock": "Unlocks at Level 191",
              "text": [
                "Increases damage to 140% + 10% (SP-based) of her consumed HP."
              ]
            }
          ]
        },
        "description_lite": "Tasi consumes HP to deal damage and stun nearby enemies, then flies to a distant enemy to deal damage and stun again."
      },
      {
        "section": "Skill2",
        "name": "Fluttering Dream",
        "unlock": "Unlocks at Level 31",
        "meta": {
          "Skill Range": "Global"
        },
        "description": {
          "raw": "Tasi enters her dream realm and transforms into a butterfly upon losing 50% (HP-based) HP. In this form, she becomes invincible, recovering 120% (ATK-based) + 10% (SP-based) HP per second while dealing 45% (ATK-based) + 5% (SP-based) damage to adjacent enemies. This effect lasts for 3s, and Tasi can cast this skill up to 2 times in one battle.",
          "active": [
            "Tasi enters her dream realm and transforms into a butterfly upon losing 50% (HP-based) HP.",
            "In this form, she becomes invincible, recovering 120% (ATK-based) + 10% (SP-based) HP per second while dealing 45% (ATK-based) + 5% (SP-based) damage to adjacent enemies.",
            "This effect lasts for 3s, and Tasi can cast this skill up to 2 times in one battle."
          ],
          "upgrades": [
            {
              "level": "2",
              "unlock": "Unlocks at Level 91",
              "text": [
                "Increases damage per second to 50% (ATK-based) + 5% (SP-based)."
