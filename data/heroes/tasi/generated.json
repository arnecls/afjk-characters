            {
              "level": "3",
              "unlock": "Unlocks at Level 151",
              "text": [
                "Increases damage per second to 55% (ATK-based) + 5% (SP-based)."
              ]
            },
            {
              "level": "4",
              "unlock": "Unlocks at Level 211",
              "text": [
                "Increases damage per second to 60% (ATK-based) + 5% (SP-based)."
              ]
            }
          ]
        },
        "description_lite": "Tasi transforms into a butterfly when she loses a certain amount of HP. In this form, she recovers HP while dealing damage to nearby enemies."
