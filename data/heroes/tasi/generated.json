        },
        "description": {
          "raw": "Tasi summons a dream that lasts for 3.5 + 0.5 (SP-based)s, hypnotizing all enemies. Hypnotized enemies cannot move or act and take 70% (ATK-based) + 12% (SP-based) damage per second.",
          "active": [
            "Tasi summons a dream that lasts for 3.5 + 0.5 (SP-based)s, hypnotizing all enemies.",
