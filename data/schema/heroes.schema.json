{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afkj.local/schema/heroes-data-processed.schema.json",
  "title": "Processed hero data",
  "description": "Per-hero summaries, synergies, and structured skill definitions. Replaces parsed effect lists with a skills section.",
  "type": "object",
  "required": ["heroes"],
  "additionalProperties": false,
  "properties": {
    "heroes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/hero"
      }
    }
  },
  "$defs": {
    "hero": {
      "type": "object",
      "required": [
        "faction",
        "class",
        "is_supporting_unit",
        "is_energy_provider",
        "skills",
        "synergy_profile",
        "damage_entries",
        "damage_magnitudes",
        "benefit_stats",
        "behavior",
        "synergies",
        "beneficiaries",
        "beneficiary_overflow_reasons",
        "replacements"
      ],
      "additionalProperties": false,
      "properties": {
        "faction": {
          "$ref": "#/$defs/faction"
        },
        "class": {
          "$ref": "#/$defs/heroClass"
        },
        "is_supporting_unit": {
          "type": "boolean",
          "description": "True for summons and companions that are not full roster heroes."
        },
        "is_energy_provider": {
          "type": "boolean",
          "description": "True when the hero meaningfully grants ally Energy."
        },
        "skills": {
          "$ref": "skills.schema.json#/$defs/heroSkills"
        },
        "synergy_profile": {
          "$ref": "#/$defs/synergyProfile"
        },
        "damage_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/damageEntry"
          },
          "description": "Damage types dealt and their reach, aggregated across all skills."
        },
        "damage_magnitudes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "description": "Roster-relative magnitude per special damage type (HP loss, Max HP-based, True damage)."
        },
        "benefit_stats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/benefitStat"
          },
          "description": "Stats the hero benefits from for synergy matching."
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        },
        "synergies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/synergy"
          },
          "description": "Top synergy partners for this hero as provider-to-receiver matches."
        },
        "beneficiaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beneficiary"
          },
          "description": "Reverse index: heroes who list this unit among their top partners."
        },
        "beneficiary_overflow_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Why additional beneficiaries were omitted from the list."
        },
        "replacements": {
          "$ref": "#/$defs/replacements"
        }
      }
    },
    "damageEntry": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "game_properties.schema.json#/$defs/damageType"
        },
        {
          "type": "string",
          "minLength": 1,
          "description": "Comma-separated reach labels detected in skill text."
        }
      ]
    },
    "damageEntryType": {
      "$ref": "game_properties.schema.json#/$defs/damageType"
    },
    "faction": {
      "$ref": "game_properties.schema.json#/$defs/faction"
    },
    "heroClass": {
      "$ref": "game_properties.schema.json#/$defs/class"
    },
    "synergyProfile": {
      "type": "object",
      "required": ["provides", "requires"],
      "additionalProperties": false,
      "description": "Hero-level synergy mechanics replacing special_effects. Provides are what the hero supplies; requires are partner dependencies.",
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/synergyMechanic"
          },
          "description": "Mechanics this hero enables for allies or the battlefield."
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/synergyMechanic"
          },
          "description": "Mechanics this hero needs from partners to reach full potential."
        }
      }
    },
    "synergyMechanic": {
      "type": "object",
      "required": ["label", "tier"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/synergyMechanicLabel"
        },
        "tier": {
          "$ref": "game_properties.schema.json#/$defs/tier"
        },
        "targeting": {
          "$ref": "#/$defs/synergyTargeting"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Supporting skill text for this mechanic."
        }
      }
    },
    "synergyMechanicLabel": {
      "type": "string",
      "enum": [
        "Adjacent allies",
        "Ally DoT on enemies",
        "Ally Ultimate casts",
        "Ally Vitality debuff on enemies",
        "Ally blessing",
        "Ally blessing active",
        "Ally empower",
        "Ally grant (Brightfeather)",
        "Ally grant (Sparks)",
        "Ally on positioning link",
        "Ally positioning link",
        "Ally stat buffs",
        "Artifact amplification",
        "Artifact buffs active",
        "Artifact echo",
        "Artifact mimic",
        "Boss encounter",
        "CC on enemies",
        "Continuous damage on enemies",
        "Counterattack",
        "Damage absorption (allies)",
        "Damage and control immunity",
        "Damage and control immunity (ally)",
        "Damage leech from allies",
        "Debuff application",
        "Debuff on target",
        "Debuff on target (Aging)",
        "Dispel debuffs",
        "DoT conversion",
        "Enemy artifact block",
        "Enemy defeat",
        "Enemy isolation (domain)",
        "Enemy monsters present",
        "Enemy not CC-immune",
        "Energy steal",
        "Enhanced form",
        "Execution scaling",
        "Fatal blow save",
        "Form or stance active",
        "HP threshold strike",
        "Heal lock (Curelock)",
        "Instant defeat",
        "Invincibility",
        "Magic damage amplification",
        "Magic damage from allies",
        "Marked target (focus fire)",
        "Monster ingredients",
        "Multiple debuffs on target",
        "Once per battle",
        "Party composition",
        "Passive with internal cooldown",
        "Permanent stat absorb",
        "Position swap",
        "Ranged damage from allies",
        "Reposition enemies",
        "Revive ally",
        "Shared HP and Energy",
        "Sleep (area)",
        "Spirit form protection",
        "Stacked resource",
        "Stacking buff",
        "Start-of-battle cast",
        "Stat absorb",
        "Stat steal",
        "Stored damage release",
        "Stored resource threshold",
        "Summoning",
        "Transformation",
        "Ultimate lock (Spellbind)",
        "Untargetable",
        "Vulnerable enemy"
      ]
    },
    "synergyTargeting": {
      "type": "string",
      "enum": [
        "Self",
        "Single target",
        "Multiple targets",
        "Arc",
        "Area",
        "All units",
        "Allies",
        "Enemies"
      ],
      "description": "Reach of the mechanic for synergy scoring."
    },
    "benefitStat": {
      "$ref": "game_properties.schema.json#/$defs/stat"
    },
    "behavior": {
      "type": "object",
      "required": [
        "movement",
        "movement_note",
        "casting_speed",
        "signature_skill_name",
        "signature_skill_is_ult",
        "signature_skill_description",
        "signature_skill_speed",
        "synergy_signature_speed",
        "synergy_signature_is_ult",
        "ult_speed",
        "non_ult_speed"
      ],
      "additionalProperties": false,
      "properties": {
        "movement": {
          "type": "string",
          "enum": [
            "stationary",
            "mostly stationary",
            "moving",
            "high movement",
            "moving / stationary"
          ]
        },
        "movement_note": {
          "type": "string"
        },
        "casting_speed": {
          "$ref": "#/$defs/castingSpeed"
        },
        "signature_skill_name": {
          "type": "string",
          "minLength": 1
        },
        "signature_skill_is_ult": {
          "type": "boolean"
        },
        "signature_skill_description": {
          "type": "string",
          "minLength": 1
        },
        "signature_skill_speed": {
          "$ref": "#/$defs/castingSpeed"
        },
        "synergy_signature_speed": {
          "$ref": "#/$defs/castingSpeed"
        },
        "synergy_signature_is_ult": {
          "type": "boolean"
        },
        "ult_speed": {
          "$ref": "#/$defs/castingSpeed"
        },
        "non_ult_speed": {
          "$ref": "#/$defs/castingSpeed"
        }
      }
    },
    "castingSpeed": {
      "type": "string",
      "enum": ["slow", "normal", "fast"]
    },
    "synergy": {
      "type": "object",
      "required": ["provider", "reasons", "score"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Display name of the synergy provider hero."
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "score": {
          "type": "number"
        }
      }
    },
    "beneficiary": {
      "type": "object",
      "required": ["name", "score"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        }
      }
    },
    "replacements": {
      "type": "object",
      "required": [
        "buff",
        "energy",
        "similar_skills",
        "damage",
        "debuff",
        "cc"
      ],
      "additionalProperties": false,
      "properties": {
        "buff": {
          "$ref": "#/$defs/replacementList"
        },
        "energy": {
          "$ref": "#/$defs/replacementList"
        },
        "similar_skills": {
          "$ref": "#/$defs/similarSkillList"
        },
        "damage": {
          "$ref": "#/$defs/replacementList"
        },
        "debuff": {
          "$ref": "#/$defs/replacementList"
        },
        "cc": {
          "$ref": "#/$defs/replacementList"
        }
      }
    },
    "replacementList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replacementMatch"
      }
    },
    "similarSkillList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/similarSkillMatch"
      }
    },
    "replacementMatch": {
      "type": "object",
      "required": ["name", "score", "matches"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "similarSkillMatch": {
      "type": "object",
      "required": ["name", "score", "matches"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Behavior tags shared with the replacement candidate."
        }
      }
    }
  }
}
