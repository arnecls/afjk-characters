{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afkj.local/schema/hero-generated.schema.json",
  "title": "Generated per-hero data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "source",
    "external",
    "derived",
    "synergies",
    "provenance"
  ],
  "properties": {
        "schema_version": { "type": "integer", "enum": [1, 2] },
    "id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walk_speed", "stat_ranks"],
      "properties": {
        "walk_speed": {
          "type": ["string", "null"],
          "enum": ["zero", "slow", "normal", "fast", "veryfast", null]
        },
        "stat_ranks": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis", "signature_calculated"],
      "properties": {
        "analysis": {
          "oneOf": [
            { "$ref": "#/$defs/analysis" },
            { "type": "null" }
          ]
        },
        "signature_calculated": { "type": ["string", "null"] }
      }
    },
    "synergies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synergies",
        "beneficiaries",
        "beneficiary_overflow_reasons",
        "replacements"
      ],
      "properties": {
        "synergies": {
          "type": "array",
          "items": { "$ref": "#/$defs/synergy" }
        },
        "beneficiaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/beneficiary" }
        },
        "beneficiary_overflow_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "replacements": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/replacement" }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_hash", "ai_hash", "overrides_hash"],
      "properties": {
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ai_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "overrides_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analysis_inputs_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "generation_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stage": {
          "type": "string",
          "enum": ["source_changed", "analyzed", "scored"]
        }
      }
    }
  },
  "$defs": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "long_name",
        "faction",
        "class",
        "role_category",
        "skills",
        "synergy_profile",
        "damage_entries",
        "damage_magnitudes",
        "benefit_stats",
        "scalar_stat_shares",
        "behavior",
        "is_energy_provider",
        "is_melee",
        "is_dual_range",
        "default_range",
        "release_date",
        "season",
        "season_number",
        "scoring"
      ],
      "properties": {
        "long_name": { "type": "string", "minLength": 1 },
        "faction": { "type": "string" },
        "class": { "type": "string" },
        "role_category": { "type": "string" },
        "skills": { "type": "object" },
        "synergy_profile": { "type": "object" },
        "damage_entries": { "type": "array" },
        "damage_magnitudes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "benefit_stats": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scalar_stat_shares": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "behavior": { "type": "object" },
        "is_energy_provider": { "type": "boolean" },
        "is_melee": { "type": "boolean" },
        "is_dual_range": { "type": "boolean" },
        "default_range": { "type": ["integer", "null"] },
        "release_date": { "type": ["string", "null"] },
        "season": { "type": ["string", "null"] },
        "season_number": { "type": ["integer", "null"] },
        "positional_tile_buff_labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proximity_aura_buff_labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proximity_aura_radius": { "type": ["number", "null"] },
        "summary_effect_magnitudes": {
          "$ref": "#/$defs/effectMagnitudes"
        },
        "scoring": {
          "$ref": "#/$defs/scoring"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_damage_type",
        "behavior_tags",
        "summon_profile",
        "prydwen_tiers",
        "effects",
        "skill_effect_magnitudes",
        "named_allies",
        "start_of_battle_output",
        "early_battle_energy",
        "effective_ally_energy",
        "shield_payoff",
        "ally_magic",
        "ranged_damage",
        "wide_area",
        "ally_grant_detail",
        "replacement_damage",
        "signature_section"
      ],
      "properties": {
        "primary_damage_type": { "type": "string" },
        "behavior_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summon_profile": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "prydwen_tiers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "effects": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "magnitude",
              "weight"
            ],
            "properties": {
              "magnitude": {
                "type": "string",
                "enum": ["low", "average", "high"]
              },
              "weight": { "type": "number" },
              "signature_cc": { "type": "boolean" },
              "battle_start_energy": { "type": "boolean" }
            }
          }
        },
        "skill_effect_magnitudes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["low", "average", "high"]
          }
        },
        "named_allies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ids", "grants"],
            "properties": {
              "ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "grants": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    { "type": "string" },
                    {
                      "type": "string",
                      "enum": ["low", "average", "high"]
                    }
                  ]
                }
              }
            }
          }
        },
        "start_of_battle_output": { "type": "boolean" },
        "early_battle_energy": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "type": "number" },
                { "type": "string" }
              ]
            },
            { "type": "null" }
          ]
        },
        "effective_ally_energy": { "type": "number" },
        "shield_payoff": { "type": "boolean" },
        "ally_magic": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "type": "number" },
                { "type": "string" }
              ]
            },
            { "type": "null" }
          ]
        },
        "ranged_damage": { "type": "boolean" },
        "wide_area": { "type": "boolean" },
        "ally_grant_detail": { "type": ["string", "null"] },
        "replacement_damage": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "signature_section": { "type": "string" }
      }
    },
    "effectMagnitudes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects", "summon_effects"],
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["low", "average", "high"]
          }
        },
        "summon_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["low", "average", "high"]
          }
        }
      }
    },
    "synergy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "score", "reasons"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "score": { "type": "number" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "beneficiary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_id", "score"],
      "properties": {
        "hero_id": { "type": "string", "minLength": 1 },
        "score": { "type": "number" }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_id", "score", "matches"],
      "properties": {
        "hero_id": { "type": "string", "minLength": 1 },
        "score": { "type": "number" },
        "matches": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "name", "skills"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "skills": { "type": "array", "minItems": 1 },
        "description": { "type": "string" }
      }
    }
  }
}
