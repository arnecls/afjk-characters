          ],
          "special_requires": [
            {
              "label": "Monster ingredients",
              "tier": "base",
              "targeting": "Enemies",
              "description": "Whenever an enemy monster is defeated, Laios collects an ingredient from it and instantly recovers 250 Energy and 500% (ATK-based) HP."
            },
            {
              "label": "Monster ingredients",
              "tier": "base",
              "description": "Laios uses the collected ingredients and cooks on the spot, recovering 500% (ATK-based) HP for allies within 2 tiles and increasing their ATK by 20%| + 5% for 8 + 0.5s."
            },
            {
              "label": "Stacked resource",
              "tier": "base",
              "description": "When activly used, for each ingredient Laios has collected, the cooked meal randomly grants one of the following extra buffs: Increases Phys DEF and Magic DEF by 40%, increases Haste by 30, or recovers 100% (ATK-based) HP per second."
            }
          ]
        }
