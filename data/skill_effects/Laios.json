              "label": "Summoning",
              "tier": "base",
              "targeting": "Single target",
              "description": "This Living Armor starts with 1,000 Energy and deals damage equal to 300% + 30% of Laios' ATK."
            },
            {
              "label": "Stacking",
              "tier": "ex+10",
              "targeting": "Single target",
              "description": "Permenantly increases Laios' Phys DEF and Magic DEf by 25% for each ingredient collected from monsters, up to 3 stacks."
