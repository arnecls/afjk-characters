            {
              "label": "Revive ally",
              "tier": "mythic+",
              "targeting": "Single target",
              "description": "After chanting for 3s, Marcille revives an allied hero and recovers 400% (ATK-based) HP for them."
            },
            {
              "label": "Stacking",
              "tier": "supreme+",
              "targeting": "Single target",
              "description": "During battle, Marcille recovers 10 additional Energy per second for each ally who is currently providing her with a buff, up to 3 stacks."
            }
          ],
          "special_requires": [
            {
              "label": "Once per battle",
              "tier": "mythic+",
              "description": "However, if Laios is on the team, this skill can revive him one additional time (no position requirement and does not consume the skill's use limit), but this can only trigger once per battle."
            },
            {
              "label": "Named ally on team",
              "tier": "base",
              "targeting": "Allies",
              "description": "If Marcille receives the buff from Laios' cooked meal, she recovers an extra 300 Energy."
            }
          ]
        }
